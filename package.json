{
  "name": "local-travel-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "backend:build": "mvn -f backend/pom.xml clean package -DskipTests",
    "backend:test": "mvn -f backend/pom.xml clean test",
    "backend:run": "mvn -f backend/pom.xml spring-boot:run"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "geolib": "^3.3.14",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.5.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
